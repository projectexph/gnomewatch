# Copy to .env (or just use the Settings page). Private values go in secrets.env, never here.
# See the Settings page for what each one does.
POLL_SECONDS=2.0
IDLE_BACKOFF=1
NOTIFY=1
KEEPALIVE=0
AUTO_RECONNECT=1
AUTO_REJOIN=0
HIDE_WINDOW=0
HIDE_ALL=0
MULTI_INSTANCE=0
DASHBOARD=1
DASHBOARD_PORT=8765
LAUNCH_TARGET=game
# secrets.env (kept out of git): LAUNCH_URL_PRIVATE=...  WEBHOOK_URL=...  INGEST_SECRET=...
